{
  "name": "menu-ordering-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "test": "playwright test",
    "test:prod": "E2E_BASE_URL=https://restaurant-order-system-blue.vercel.app E2E_USE_WEB_SERVER=false playwright test",
    "test:local": "E2E_BASE_URL=http://127.0.0.1:3010 E2E_USE_WEB_SERVER=true playwright test",
    "test:live-top10": "playwright test tests/live-orders.expanded.top10.spec.ts",
    "test:live-11-25": "playwright test tests/live-orders.expanded.11-25.spec.ts",
    "test:live-26-45": "playwright test tests/live-orders.expanded.26-45.spec.ts",
    "test:menu-top10": "playwright test tests/menu.client.top10.spec.ts",
    "test:menu-11-20": "playwright test tests/menu.client.11-20.spec.ts",
    "test:menu-21-30": "playwright test tests/menu.client.21-30.spec.ts",
    "test:menu-31-40": "playwright test tests/menu.client.31-40.spec.ts",
    "test:menu-41-54": "playwright test tests/menu.client.41-54.spec.ts",
    "test:menu-all": "playwright test tests/menu.client.top10.spec.ts tests/menu.client.11-20.spec.ts tests/menu.client.21-30.spec.ts tests/menu.client.31-40.spec.ts tests/menu.client.41-54.spec.ts",
    "test:integration-menu-live": "playwright test tests/menu-live.integration.spec.ts",
    "test:integration-advanced": "playwright test tests/menu-live-tables.integration.advanced.spec.ts",
    "test:menu-banners": "E2E_BASE_URL=http://127.0.0.1:3010 E2E_USE_WEB_SERVER=true playwright test tests/menu.banners.spec.ts",
    "test:menu-smoke": "playwright test tests/menu.client.smoke.spec.ts",
    "test:tables-shift": "E2E_BASE_URL=http://127.0.0.1:3010 E2E_USE_WEB_SERVER=true playwright test tests/tables.closed-shift.spec.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
