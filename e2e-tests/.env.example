E2E_BASE_URL=https://restaurant-order-system-blue.vercel.app
E2E_USE_WEB_SERVER=false
E2E_WEB_SERVER_COMMAND=npm run dev --prefix ..
E2E_MENU_RESTAURANT_SLUG=olive-bistro
E2E_MENU_PREVIEW_PATH=/menu/olive-bistro/0
# Optional: explicit table path used by ordering checks.
E2E_ORDERING_MENU_PATH=
# Optional: fallback table path if E2E_ORDERING_MENU_PATH is empty.
E2E_DEFAULT_ORDERING_MENU_PATH=/olive-bistro/menu/tbl_GkoFz28VwFqC
E2E_UNAVAILABLE_ITEM_NAME=Hummus with pita
E2E_UNAVAILABLE_ITEM_ID=m1
# Optional: paths with forced menu state for TC-25..TC-30.
E2E_KITCHEN_CLOSED_MENU_PATH=
E2E_BAR_CLOSED_MENU_PATH=
E2E_OPEN_CLOSE_TOGGLE_MENU_PATH=
# Optional: dedicated paths for promo/business-lunch checks (TC-43..TC-46).
E2E_PROMO_ACTIVE_MENU_PATH=
E2E_PROMO_INACTIVE_MENU_PATH=
E2E_BUSINESS_LUNCH_MENU_PATH=
E2E_BUSINESS_LUNCH_HIDDEN_ITEM=
# Local-mode suites:
# - menu.banners.spec.ts requires E2E_USE_WEB_SERVER=true and local app (http://127.0.0.1:3010)
# - tables.closed-shift.spec.ts duplicate-guard test requires E2E_USE_WEB_SERVER=true
